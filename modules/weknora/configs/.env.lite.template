# =====================================================================
# WeKnora Lite Configuration Template
# Optimized for: 6GB GPU VRAM / 16GB System RAM with Local LLM (Ollama)
# =====================================================================

# Gin server mode: debug | release
GIN_MODE=release

# Server binding (Default: 127.0.0.1:8082 to avoid conflicting with One EAD on 8100)
SERVER_HOST=127.0.0.1
SERVER_PORT=8082
PORT=8082

# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info

# === Database (Embedded SQLite + FTS5) ===
DB_DRIVER=sqlite
DB_PATH=./data/weknora.db

# === Retrieval Engine (sqlite-vec + SQLite FTS5) ===
RETRIEVE_DRIVER=sqlite

# === File Storage (Local disk storage) ===
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# === Stream & Task Manager (In-memory, Zero Redis dependency) ===
STREAM_MANAGER_TYPE=memory

# === Local LLM Service (Ollama) ===
# By default points to local Ollama on loopback
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended Ollama Models for 6GB VRAM:
# Chat:      qwen2.5:3b (Ultra-fast, ~2.0GB VRAM) OR qwen2.5:7b-instruct-q4_K_M (~4.4GB VRAM)
# Embedding: nomic-embed-text (~275MB VRAM) OR bge-small-zh-v1.5 (~130MB VRAM)

# OpenAI Compatible API (Optional fallback or external inference)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Security & Keys ===
# Auto-generated if left empty
SYSTEM_AES_KEY=
JWT_SECRET=

# === Feature Toggles ===
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=disabled
ENABLE_GRAPH_RAG=false
DISABLE_REGISTRATION=false

# === Performance Tuning for 6GB VRAM / 16GB RAM ===
# Lower concurrency to prevent context window thrashing & CUDA OOM
CONCURRENCY_POOL_SIZE=2

# Document attachment OCR concurrency (Keep at 1 for 6GB VRAM to avoid VRAM exhaustion)
WEKNORA_CHAT_ATTACHMENT_OCR_CONCURRENCY=1
WEKNORA_CHAT_ATTACHMENT_OCR_MAX_PAGES=4

# Timeout settings
WEKNORA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
WEKNORA_CHAT_ATTACHMENT_TTL_HOURS=24
